<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A tiny test runner with no NuGet packages, so tests run anywhere the .NET SDK is installed:
      dotnet run (from tests/VedicPandit.Tests)
    Exit code 0 = all passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VedicPandit.Infrastructure\VedicPandit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\VedicPandit.WebAPI\SeedData\**\*.json" Link="SeedData\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
